# ==============================================================================
# CONFIGURACIÓN LOCAL PRIVADA DE BASE DE DATOS (NO SE SUBE A GITHUB)
# ==============================================================================
# Si tu MySQL local tiene contraseña o usa un puerto distinto:
# 1. Haz una copia de este archivo en esta misma carpeta principal del proyecto.
# 2. Renombra la copia exactamente como: application-local.properties
# 3. Descomenta la línea de la contraseña y escribe tu clave real de MySQL.
# 4. Listo. Spring Boot usará tus credenciales locales sin afectar a tus compañeros.
# ==============================================================================

# Si tu usuario root tiene contraseña, descomenta y escribe tu clave:
# spring.datasource.password=tu_contrasena_aqui

# Si tu usuario no es root (por ejemplo, si creaste otro usuario):
# spring.datasource.username=root

# Si tu puerto MySQL es distinto a 3306 (por ejemplo 3307 o 3308):
# spring.datasource.url=jdbc:mysql://localhost:3307/sgg?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8


